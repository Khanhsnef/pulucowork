{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.codegraph": true,
    "**/.codex": true,
    "**/Local-AI-Setup/stable-diffusion-webui-forge/venv": true,
    "**/Local-AI-Setup/stable-diffusion-webui-forge/models": true,
    "**/Local-AI-Setup/stable-diffusion-webui-forge/outputs": true,
    "**/Local-AI-Setup/stable-diffusion-webui-forge/repositories": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.hg/store/**": true,
    "**/.codegraph/**": true,
    "**/.codex/**": true,
    "**/Local-AI-Setup/stable-diffusion-webui-forge/venv/**": true,
    "**/Local-AI-Setup/stable-diffusion-webui-forge/models/**": true,
    "**/Local-AI-Setup/stable-diffusion-webui-forge/outputs/**": true,
    "**/Local-AI-Setup/stable-diffusion-webui-forge/repositories/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/.codegraph": true,
    "**/.codex": true,
    "**/Local-AI-Setup/stable-diffusion-webui-forge/venv": true,
    "**/Local-AI-Setup/stable-diffusion-webui-forge/models": true,
    "**/Local-AI-Setup/stable-diffusion-webui-forge/outputs": true,
    "**/Local-AI-Setup/stable-diffusion-webui-forge/repositories": true
  }
}
