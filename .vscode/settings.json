{
  "files.encoding": "utf8",
  "terminal.integrated.env.osx": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "LANGUAGE": "vi:en",
    "PYTHONIOENCODING": "utf-8"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.tmp": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.tmp": true,
    "**/.codegraph": true,
    "**/.codex": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.tmp/**": true,
    "**/.codegraph/**": true,
    "**/.codex/**": true
  },
  "liveServer.settings.port": 5501
}
